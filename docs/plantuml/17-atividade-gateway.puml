@startuml 17-atividade-gateway
title Gateway — Decisão de acesso por requisição

skinparam shadowing false
skinparam defaultFontName "Segoe UI"

start
:Requisição HTTP chega em /api/**;
:Extrai Bearer (sessão) e X-Assinatura;
:MapaDeAcesso.nivel(método, caminho);

switch (NivelDeAcesso?)
case (PUBLICO)
  :Liberado anônimo;
case (PUBLICO_COM_SESSAO_OPCIONAL)
  if (sessão válida de GERENTE?) then (sim)
    :Liberado como GERENTE;
  else (não)
    :Liberado anônimo;
  endif
case (CLIENTE / GERENTE)
  if (sessão válida?) then (não)
    #pink:401 SESSAO_OBRIGATORIA;
    stop
  endif
  if (perfil confere?) then (não)
    #pink:403 ACESSO_NEGADO;
    stop
  endif
  :Liberado com perfil;
case (CLIENTE_COM_ASSINATURA)
  if (sessão válida de CLIENTE?) then (não)
    #pink:401 / 403;
    stop
  endif
  if (assinatura HMAC válida,\nnão expirada (120 s) e\ndo mesmo cliente?) then (não)
    #pink:401 ASSINATURA_OBRIGATORIA;
    stop
  endif
  :Liberado com perfil CLIENTE;
case (NEGADO)
  #pink:403 ACESSO_NEGADO;
  stop
endswitch

:RequisicaoComIdentidade\ninjeta X-Cliente-Id e X-Perfil;
:Encaminha ao microserviço de destino;
stop
@enduml
