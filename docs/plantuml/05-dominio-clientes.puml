@startuml 05-dominio-clientes
title Clientes — Modelo de domínio

skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam classAttributeIconSize 0
hide empty members

package "com.orbitapay.clientes.domain.model" {
  class Cliente <<Aggregate Root>> {
    + {static} LIMITE_TENTATIVAS_PIN : int = 3
    - id : String
    - pinCodificado : String
    - bloqueado : boolean
    - tentativasFalhas : int
    - clienteDesde : Instant
    --
    + {static} novo(id, nome, email, cpf, pinCodificado, agora) : Cliente
    + {static} reconstituir(...) : Cliente
    + atualizarDados(nome, email)
    + corrigirCpf(cpf)
    + alterarPin(novoPinCodificado)
    + registrarPinIncorreto() : boolean
    + registrarPinCorreto()
    + bloquear(motivo)
    + desbloquearPeloCliente()
    + desbloquearPeloGerente()
    + tentativasRestantes() : int
  }

  class NomeCompleto <<Value Object>> {
    valor : String
    .. nome e sobrenome ..
  }
  class Email <<Value Object>> {
    valor : String
    .. minúsculo, formato válido ..
  }
  class Cpf <<Value Object>> {
    valor : String
    .. 11 dígitos, 000.000.000-00 ..
  }
  class Pin <<Value Object>> {
    valor : String
    .. 4 dígitos, toString() = **** ..
  }
  enum MotivoBloqueio {
    PIN
    GERENTE
    CLIENTE
  }
}

package "com.orbitapay.clientes.domain.event" {
  interface EventoDeCliente
  class ClienteCadastrado
  class ClienteAtualizado
  class ClienteSituacaoAlterada
  class ClienteRemovido
  EventoDeCliente <|.. ClienteCadastrado
  EventoDeCliente <|.. ClienteAtualizado
  EventoDeCliente <|.. ClienteSituacaoAlterada
  EventoDeCliente <|.. ClienteRemovido
}

Cliente *-- "1" NomeCompleto : nome
Cliente *-- "1" Email : email
Cliente *-- "1" Cpf : cpf
Cliente --> "0..1" MotivoBloqueio : motivoBloqueio
Cliente ..> Pin : conferido via\nCodificadorDePin

note right of Cliente
  3 PINs errados → bloquear(PIN)
  e publica cliente.situacao-alterada.
  Cliente só desbloqueia se o
  motivo for CLIENTE.
end note
@enduml
