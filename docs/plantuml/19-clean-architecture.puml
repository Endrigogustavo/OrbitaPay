@startuml 19-clean-architecture
title Clean Architecture / monolito modular — exemplo: negociacao-service

skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam classAttributeIconSize 0
hide empty members

package "módulo springframework" <<Frame>> {

package "infrastructure" #F3E5F5 {
  class CasosDeUsoConfig <<@Configuration>>
  class RabbitConfig <<@Configuration>>
}

package "adapter" #E3F2FD {
  package "in.web" {
    class OrdemController <<@RestController>>
  }
  package "in.messaging" {
    class SagaDeOrdemListener <<@RabbitListener>>
    class AtivoListener <<@RabbitListener>>
    class ClienteListener <<@RabbitListener>>
  }
  package "out.persistence" {
    class OrdemRepositoryMongoAdapter
    class AtivoNegociavelRepositoryMongoAdapter
    class InvestidorRepositoryMongoAdapter
    class TravaPessimistaMongo
  }
  package "out.messaging" {
    class RabbitPublicadorDeEventosDeOrdem
    class RabbitCatalogoDeAtivos
  }
}

}

package "módulo domain (Java puro)" <<Frame>> {

package "application" #FFF3E0 {
  package "port.in" {
    interface EnviarOrdemUseCase
    interface ConcluirOrdemUseCase
    interface ConsultarOrdensUseCase
    interface SincronizarAtivosUseCase
    interface SincronizarInvestidoresUseCase
  }
  package "usecase" {
    class EnviarOrdem
    class ConcluirOrdem
    class ConsultarOrdens
    class SincronizarAtivos
    class SincronizarInvestidores
    class OperacaoComTrava
  }
  package "port.out" {
    interface OrdemRepository
    interface AtivoNegociavelRepository
    interface InvestidorRepository
    interface PublicadorDeEventosDeOrdem
    interface CatalogoDeAtivos
  }
}

package "domain" #E8F5E9 {
  class Ordem
  class AtivoNegociavel
  class Investidor
}

}

OrdemController --> EnviarOrdemUseCase
OrdemController --> ConsultarOrdensUseCase
SagaDeOrdemListener --> ConcluirOrdemUseCase
AtivoListener --> SincronizarAtivosUseCase
ClienteListener --> SincronizarInvestidoresUseCase

EnviarOrdemUseCase <|.. EnviarOrdem
ConcluirOrdemUseCase <|.. ConcluirOrdem
ConsultarOrdensUseCase <|.. ConsultarOrdens
SincronizarAtivosUseCase <|.. SincronizarAtivos
SincronizarInvestidoresUseCase <|.. SincronizarInvestidores

EnviarOrdem --> OperacaoComTrava
ConcluirOrdem --> OperacaoComTrava
OperacaoComTrava --> AtivoNegociavelRepository
EnviarOrdem --> OrdemRepository
EnviarOrdem --> InvestidorRepository
EnviarOrdem --> CatalogoDeAtivos
EnviarOrdem --> PublicadorDeEventosDeOrdem
ConcluirOrdem --> PublicadorDeEventosDeOrdem

OrdemRepository <|.. OrdemRepositoryMongoAdapter
AtivoNegociavelRepository <|.. AtivoNegociavelRepositoryMongoAdapter
InvestidorRepository <|.. InvestidorRepositoryMongoAdapter
PublicadorDeEventosDeOrdem <|.. RabbitPublicadorDeEventosDeOrdem
CatalogoDeAtivos <|.. RabbitCatalogoDeAtivos
AtivoNegociavelRepositoryMongoAdapter --> TravaPessimistaMongo

EnviarOrdem ..> Ordem
EnviarOrdem ..> AtivoNegociavel
EnviarOrdem ..> Investidor
ConcluirOrdem ..> Ordem

CasosDeUsoConfig ..> EnviarOrdem : instancia
CasosDeUsoConfig ..> ConcluirOrdem : instancia

note bottom of domain
  Dependências sempre para dentro:
  infrastructure → adapter → application → domain.
  O módulo domain (domain + application) não tem nenhuma
  dependência no pom: nada de Spring, MongoDB ou RabbitMQ.
end note
@enduml
