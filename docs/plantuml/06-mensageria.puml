@startuml 06-mensageria
title Topologia RabbitMQ — exchange, filas e DLQ

skinparam shadowing false
skinparam defaultFontName "Segoe UI"
left to right direction

rectangle "Publicadores" {
  component Auth as P_AUT
  component Clientes as P_CLI
  component Ativos as P_ATV
  component "Negociação" as P_NEG
  component Contas as P_CON
  component Carteira as P_CAR
  component Pagamentos as P_PAG
}

node "orbita.eventos\n(topic, durável)" as EX

rectangle "Auth" as SAUT {
  queue "auth.cliente-eventos\n[cliente.#] · 1 consumidor" as qa1
}

rectangle "Clientes" as SCLI {
  queue "clientes.credencial-eventos\n[credencial.#]" as qc1
}

rectangle "Contas" as SCON {
  queue "contas.cliente-eventos\n[cliente.#] · 1 consumidor" as q1
  queue "contas.ordem-compra-solicitada\n[ordem.compra-solicitada]" as q2
  queue "contas.ordem-executada\n[ordem.executada]" as q3
  queue "contas.pagamento-confirmado\n[pagamento.confirmado]" as q15
}

rectangle "Negociação" as SNEG {
  queue "negociacao.cliente-eventos\n[cliente.#] · 1 consumidor" as q4
  queue "negociacao.ativo-eventos\n[ativo.#] · 1 consumidor" as q5
  queue "negociacao.debito-aprovado\n[conta.debito-aprovado]" as q6
  queue "negociacao.debito-recusado\n[conta.debito-recusado]" as q7
  queue "negociacao.acoes-reservadas\n[carteira.acoes-reservadas]" as q8
  queue "negociacao.acoes-insuficientes\n[carteira.acoes-insuficientes]" as q9
}

rectangle "Carteira" as SCAR {
  queue "carteira.cliente-eventos\n[cliente.#] · 1 consumidor" as q10
  queue "carteira.ativo-eventos\n[ativo.#] · 1 consumidor" as q11
  queue "carteira.ordem-venda-solicitada\n[ordem.venda-solicitada]" as q12
  queue "carteira.ordem-executada\n[ordem.executada]" as q13
  queue "carteira.ordem-rejeitada\n[ordem.rejeitada]" as q14
}

rectangle "Relatórios" as SREL {
  queue "relatorios.cliente-eventos\n[cliente.#] · 1 consumidor" as qr1
  queue "relatorios.ordem-eventos\n[ordem.executada, ordem.rejeitada]" as qr2
  queue "relatorios.pagamento-eventos\n[pagamento.#]" as qr3
}

queue "ativos.consultas\n(request/reply · direct reply-to)" as qcons
queue "auth.registros-de-credencial\n(request/reply · direct reply-to)" as qreg

node "orbita.eventos.mortos\n(topic)" as DLX
queue "auth.dlq" as dlq0
queue "clientes.dlq" as dlqc
queue "contas.dlq" as dlq1
queue "negociacao.dlq" as dlq2
queue "carteira.dlq" as dlq3
queue "relatorios.dlq" as dlqr

P_AUT --> EX : credencial.*
P_CLI --> EX : cliente.*
P_ATV --> EX : ativo.*
P_NEG --> EX : ordem.*
P_CON --> EX : conta.*
P_CAR --> EX : carteira.*
P_PAG --> EX : pagamento.*

EX --> qa1
EX --> qc1
EX --> q1
EX --> q2
EX --> q3
EX --> q15
EX --> q4
EX --> q5
EX --> q6
EX --> q7
EX --> q8
EX --> q9
EX --> q10
EX --> q11
EX --> q12
EX --> q13
EX --> q14
EX --> qr1
EX --> qr2
EX --> qr3

P_NEG ..> qcons : consulta ticker
P_CAR ..> qcons : consulta ticker
qcons ..> P_ATV : ConsultaDeAtivoListener

P_CLI ..> qreg : cadastro do cliente
qreg ..> P_AUT : RegistroDeCredencialListener

SAUT ..> DLX : após 3 tentativas
SCLI ..> DLX : após 3 tentativas
SCON ..> DLX : após 3 tentativas
SNEG ..> DLX : após 3 tentativas
SCAR ..> DLX : após 3 tentativas
SREL ..> DLX : após 3 tentativas
DLX --> dlq0 : auth.#
DLX --> dlqc : clientes.#
DLX --> dlq1 : contas.#
DLX --> dlq2 : negociacao.#
DLX --> dlq3 : carteira.#
DLX --> dlqr : relatorios.#

note bottom of EX
  Toda mensagem carrega: eventoId, evento, mensagem, enviadoEm.
  Filas da saga: concorrência 3–6 consumidores, protegidas por lock pessimista.
  Filas de ciclo de vida (cliente.#, ativo.#): consumidor único para manter a ordem.
  Ativos e Pagamentos só publicam: não têm filas de assinatura nem DLQ.
end note
@enduml
