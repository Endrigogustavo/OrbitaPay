@startuml 06-dominio-contas
title Contas — Modelo de domínio

skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam classAttributeIconSize 0
hide empty members

package "com.orbitapay.contas.domain.model" {
  class Conta <<Aggregate Root>> {
    + {static} AGENCIA : String = "0001"
    + {static} LIMITE_POR_DEPOSITO : Dinheiro = 50.000
    + {static} LIMITE_POR_SAQUE : Dinheiro = 5.000
    - id : String
    - clienteId : String
    - nomeTitular : String
    - titularBloqueado : boolean
    - numero : String
    - abertaEm : Instant
    --
    + {static} abrir(id, clienteId, nomeTitular, numero, depositoInicial, agora) : Conta
    + {static} reconstituir(...) : Conta
    + depositar(valor, metodo, agora) : Lancamento
    + sacar(valor, agora) : Lancamento
    + debitarCompraDeAcoes(ordemId, valor, descricao, agora) : Lancamento
    + creditarVendaDeAcoes(ordemId, valor, descricao, agora) : Lancamento
    + atualizarTitular(nome)
    + alterarSituacaoDoTitular(bloqueado)
  }

  class Lancamento <<Value Object>> {
    id : String
    tipo : TipoLancamento
    valor : Dinheiro
    descricao : String
    ordemId : String
    ocorridoEm : Instant
    --
    + referenteA(ordemId) : boolean
  }

  class Dinheiro <<Value Object>> {
    valor : BigDecimal (escala 2)
    --
    + somar(outro) : Dinheiro
    + subtrair(outro) : Dinheiro
    + negativo() : Dinheiro
    + positivo() : boolean
    + maiorQue(outro) : boolean
    + formatado() : String
  }

  enum TipoLancamento {
    ABERTURA
    DEPOSITO
    SAQUE
    COMPRA_DE_ACOES
    VENDA_DE_ACOES
  }
}

package "com.orbitapay.contas.domain.event" {
  interface EventoDeConta
  class DebitoDeCompraAprovado
  class DebitoDeCompraRecusado
  EventoDeConta <|.. DebitoDeCompraAprovado
  EventoDeConta <|.. DebitoDeCompraRecusado
}

package "com.orbitapay.contas.domain.exception" {
  class RegraDeNegocioException
  class SaldoInsuficienteException
  class ContaBloqueadaException
  class ContaNaoEncontradaException
  RegraDeNegocioException <|-- SaldoInsuficienteException
}

Conta *-- "1" Dinheiro : saldo
Conta *-- "0..*" Lancamento : lancamentos
Lancamento --> TipoLancamento
Lancamento --> Dinheiro

note right of Conta
  ACL "Titular": nomeTitular e titularBloqueado
  vêm dos eventos cliente.* (não do banco de Clientes).
  Débito/crédito de ordem é idempotente por ordemId.
end note
@enduml
