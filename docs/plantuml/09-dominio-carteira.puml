@startuml 09-dominio-carteira
title Carteira — Modelo de domínio

skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam classAttributeIconSize 0
hide empty members

package "com.orbitapay.carteira.domain.model" {
  class Carteira <<Aggregate Root>> {
    - id : String
    - clienteId : String
    - ordensLiquidadas : Set<String>
    --
    + {static} abrir(id, clienteId) : Carteira
    + {static} reconstituir(...) : Carteira
    + registrarCompra(ordemId, ticker, qtd, precoUnitario)
    + reservarParaVenda(ordemId, ticker, qtd)
    + liquidarVenda(ordemId, ticker)
    + cancelarReserva(ordemId, ticker)
  }

  class Posicao <<Entity>> {
    - ticker : String
    - quantidade : long
    - precoMedio : BigDecimal
    - reservas : Map<ordemId, Long>
    --
    ~ adicionar(qtd, precoUnitario)
    ~ reservar(ordemId, qtd)
    ~ liquidarReserva(ordemId) : long
    ~ cancelarReserva(ordemId)
    + quantidadeReservada() : long
    + quantidadeDisponivel() : long
    + vazia() : boolean
  }

  class AtivoCotado <<Projeção ACL>> {
    ticker : String
    nome : String
    moeda : String
    cambio : BigDecimal
    cotacao : BigDecimal
    --
    + comCotacao(nova) : AtivoCotado
    + emReais(valor) : BigDecimal
  }
}

package "com.orbitapay.carteira.domain.event" {
  interface EventoDeCarteira
  class AcoesReservadas
  class AcoesInsuficientes
  EventoDeCarteira <|.. AcoesReservadas
  EventoDeCarteira <|.. AcoesInsuficientes
}

package "com.orbitapay.carteira.application.dto" {
  class CarteiraValorizada {
    posicoes : List<PosicaoValorizada>
  }
}

Carteira *-- "0..*" Posicao : posicoes (por ticker)
Posicao ..> AtivoCotado : ticker
CarteiraValorizada ..> Carteira
CarteiraValorizada ..> AtivoCotado : cotação × câmbio

note right of Posicao
  precoMedio = (custoAtual + custoNovo) / qtdTotal
  disponível = quantidade − Σ reservas
end note
note left of Carteira
  ordensLiquidadas garante
  idempotência por ordemId.
end note
@enduml
