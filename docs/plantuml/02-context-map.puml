@startuml 02-context-map
title OrbitaPay — Contextos e o que cada um guarda

skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam rectangle {
  RoundCorner 12
}

rectangle "**Auth**\nCredencial · Funcionário\nSessão · Assinatura" as AUT #F3E5F5
rectangle "**Clientes**\nCliente · Conta · Lançamento" as CLI #E3F2FD
rectangle "**Ativos**\nAtivo (cotação + estoque) · Bolsa" as ATV #E3F2FD
rectangle "**Negociação**\nOrdem · Carteira · Posição" as NEG #FFF3E0
rectangle "**Pagamentos**\nPagamento · Cobrança" as PAG #E8F5E9

AUT --> CLI : bloqueia por PIN\n(clienteId)
CLI --> AUT : atualiza e-mail de login\n(clienteId)
NEG --> ATV : cotação e estoque\n(ticker)
NEG --> CLI : situação, débito e crédito\n(clienteId · ordemId)
PAG ..> CLI : pagamento.confirmado\n(clienteId · pagamentoId)
CLI ..> AUT : cliente.removido
CLI ..> NEG : cliente.removido
CLI ..> PAG : cliente.removido
NEG ..> NEG : ordem.solicitada
(ordemId)

legend right
  seta contínua = HTTP (resposta na hora)
  seta tracejada = evento no RabbitMQ
  entre parênteses = o ID usado para buscar o dado no serviço dono
endlegend
@enduml
