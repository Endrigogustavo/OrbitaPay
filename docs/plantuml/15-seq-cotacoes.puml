@startuml 15-seq-cotacoes
title Cotações simuladas ao vivo (a cada 3 s)

skinparam shadowing false
skinparam defaultFontName "Segoe UI"
autonumber

participant "CotacoesAgendadas\n@Scheduled" as AG
participant "SimularCotacoes" as SIM
participant "SimuladorDeMercado\nAleatorio" as MKT
database "orbita_ativos" as DB
queue "RabbitMQ" as MQ
participant "Negociação" as NEG
participant "Carteira" as CAR

AG -> SIM : executar()
SIM -> DB : listar ativos
loop para cada Ativo
  SIM -> MKT : proximaCotacao(atual)
  opt houve variação
    SIM -> SIM : ativo.registrarCotacao(nova)\n(histórico limitado a 40 pontos)
  end
end
opt algum ativo alterado
  SIM -> DB : atualizarCotacoes(alterados)
  SIM ->> MQ : ativo.cotacoes-atualizadas [(ticker, cotação)...]
  MQ ->> NEG : negociacao.ativo-eventos (consumidor único)
  NEG -> NEG : AtivoNegociavel.atualizarCotacao()
  MQ ->> CAR : carteira.ativo-eventos (consumidor único)
  CAR -> CAR : AtivoCotado.comCotacao()
end
@enduml
