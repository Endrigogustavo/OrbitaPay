@startuml 11-seq-login-assinatura
title Login por PIN e assinatura de operação

skinparam shadowing false
skinparam defaultFontName "Segoe UI"
autonumber

actor Cliente
participant "App" as APP
participant "Gateway" as GW
participant "Clientes" as CLI
participant "ConferenciaDePin" as CONF
database "orbita_clientes" as DB
queue "RabbitMQ" as MQ

== Login ==
Cliente -> APP : e-mail + PIN
APP -> GW : POST /api/autenticacao/clientes
GW -> GW : MapaDeAcesso → PUBLICO
GW -> CLI : repassa
CLI -> DB : buscarPorEmail
CLI -> CONF : conferir(cliente, pin)
alt PIN correto
  CONF -> DB : tentativasFalhas = 0
  CLI -> CLI : emitirSessaoDeCliente (HMAC, 240 min)
  CLI --> APP : 200 {token de sessão, cliente}
else PIN incorreto
  CONF -> DB : tentativasFalhas++
  opt 3ª tentativa
    CONF -> DB : bloquear(PIN)
    CONF ->> MQ : cliente.situacao-alterada {bloqueado=true}
  end
  CLI --> APP : 401 PinIncorreto {tentativasRestantes}
end

== Assinatura (antes de saque ou ordem) ==
Cliente -> APP : confirma com PIN
APP -> GW : POST /api/clientes/me/assinaturas\nAuthorization: Bearer <sessão>
GW -> GW : verifica HMAC da sessão → CLIENTE
GW -> CLI : repassa com X-Cliente-Id
CLI -> CONF : conferir(cliente, pin)
CLI -> CLI : emitirAssinatura (HMAC, 120 s)
CLI --> APP : 200 {token de assinatura}

== Uso da assinatura ==
APP -> GW : POST /api/ordens ou /api/contas/me/saques\nBearer <sessão> + X-Assinatura
GW -> GW : CLIENTE_COM_ASSINATURA:\nassinatura.sujeito == sessão.sujeito?
alt assinatura válida
  GW -> GW : injeta X-Cliente-Id e X-Perfil
  note right : segue para o serviço de destino
else ausente / expirada / de outro cliente
  GW --> APP : 401 ASSINATURA_OBRIGATORIA
end
@enduml
