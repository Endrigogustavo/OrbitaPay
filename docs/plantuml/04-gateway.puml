@startuml 04-gateway
title Gateway — Controle de acesso (classes)

skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam classAttributeIconSize 0
hide empty members

package "springframework" {
  package "web" {
    class FiltroDeAcesso <<OncePerRequestFilter>> {
      + doFilterInternal(req, resp, cadeia)
    }
    class RequisicaoComIdentidade <<HttpServletRequestWrapper>> {
      .. injeta X-Cliente-Id / X-Perfil ..
    }
    class CabecalhosInternos <<utility>> {
      CLIENTE_ID / PERFIL / ASSINATURA
    }
  }

  package "seguranca" {
    class HmacVerificadorDeCredencial
  }

  package "infrastructure.config" {
    class GatewayConfig <<Configuration>> {
      + controleDeAcesso(verificador, relogio)
      + filtroDeAcesso(controleDeAcesso)
      + filtroDeCors()
    }
  }
}

package "domain (módulo Java puro)" {
  package "application" {
    class ControleDeAcesso {
      + decidir(metodo, caminho, tokenDeSessao, tokenDeAssinatura) : Decisao
    }
    class MapaDeAcesso <<utility>> {
      + {static} nivel(metodo, caminho) : NivelDeAcesso
    }
  }

  package "domain" {
    interface VerificadorDeCredencial {
      + verificar(token) : Credencial / null
    }
    class Credencial <<record>> {
      tipo : TipoDeCredencial
      sujeito : String
      perfil : Perfil
      expiraEm : Instant
      --
      + validaEm(instante) : boolean
      + sessaoDe(perfil) : boolean
      + assinaturaDe(clienteId) : boolean
    }
    class Decisao <<record>> {
      liberado : boolean
      status : int
      codigo : String
      mensagem : String
      clienteId : String
      perfil : Perfil
    }
    enum NivelDeAcesso {
      PUBLICO
      PUBLICO_COM_SESSAO_OPCIONAL
      CLIENTE
      CLIENTE_COM_ASSINATURA
      GERENTE
      NEGADO
    }
    enum Perfil {
      CLIENTE
      GERENTE
    }
    enum TipoDeCredencial {
      SESSAO
      ASSINATURA
    }
  }
}

GatewayConfig ..> ControleDeAcesso : cria
GatewayConfig ..> FiltroDeAcesso : registra
FiltroDeAcesso --> ControleDeAcesso
FiltroDeAcesso ..> RequisicaoComIdentidade : cria se liberado
RequisicaoComIdentidade ..> CabecalhosInternos
ControleDeAcesso ..> MapaDeAcesso
ControleDeAcesso --> VerificadorDeCredencial
VerificadorDeCredencial <|.. HmacVerificadorDeCredencial
ControleDeAcesso ..> Decisao
Decisao --> Perfil
Credencial --> TipoDeCredencial
Credencial --> Perfil
MapaDeAcesso ..> NivelDeAcesso
@enduml
