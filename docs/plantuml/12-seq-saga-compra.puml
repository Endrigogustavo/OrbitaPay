@startuml 12-seq-saga-compra
title Saga de COMPRA de ações (orquestrada pela Negociação)

skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam sequenceMessageAlign center
autonumber

participant "App" as APP
participant "Gateway" as GW
participant "Negociação" as NEG
database "orbita_negociacao" as NDB
participant "Ativos" as ATV
queue "RabbitMQ\norbita.eventos" as MQ
participant "Contas" as CON
participant "Carteira" as CAR

APP -> GW : POST /api/ordens {ticker, COMPRA, qtd}\nBearer + X-Assinatura
GW -> NEG : repassa com X-Cliente-Id
NEG -> NEG : Investidor.exigirLiberado()

opt ticker ainda não está na projeção
  NEG -> ATV : ativos.consultas {ticker} (request/reply)
  ATV --> NEG : {encontrado, cotacao, cambio, qtdEmitida}
  NEG -> NDB : inserir AtivoNegociavel
end

group LOCK PESSIMISTA (AtivoNegociavel por ticker)
  NEG -> NDB : travar(ticker)
  NEG -> NEG : reservarParaCompra(qtd)\ndisponível −= qtd · reservada += qtd
  NEG -> NEG : Ordem.abrir() → PENDENTE
  NEG -> NDB : salvarELiberar
end
NEG -> NDB : salvar ordem
NEG ->> MQ : ordem.compra-solicitada
NEG --> APP : 202 Accepted · PENDENTE

MQ ->> CON : contas.ordem-compra-solicitada
group LOCK PESSIMISTA (Conta por clienteId)
  CON -> CON : debitarCompraDeAcoes(ordemId, valor)\nvalida bloqueio e saldo
end

alt saldo suficiente
  CON ->> MQ : conta.debito-aprovado
  MQ ->> NEG : negociacao.debito-aprovado
  group LOCK no ativo
    NEG -> NEG : confirmarCompra(qtd)\nreservada −= qtd
  end
  NEG -> NEG : ordem.executar() → EXECUTADA
  NEG ->> MQ : ordem.executada
  MQ ->> CAR : carteira.ordem-executada
  group LOCK PESSIMISTA (Carteira por clienteId)
    CAR -> CAR : registrarCompra()\nposição += qtd · recalcula preço médio
  end
  MQ ->> CON : contas.ordem-executada
  note right of CON : compra → ignora\n(já debitado)
else saldo insuficiente / conta bloqueada
  CON ->> MQ : conta.debito-recusado {motivo}
  MQ ->> NEG : negociacao.debito-recusado
  group LOCK no ativo — COMPENSAÇÃO
    NEG -> NEG : cancelarReserva(qtd)\nreservada −= qtd · disponível += qtd
  end
  NEG -> NEG : ordem.rejeitar(motivo) → REJEITADA
  NEG ->> MQ : ordem.rejeitada
end

loop até sair de PENDENTE
  APP -> GW : GET /api/ordens/{id}
  GW -> NEG : repassa
  NEG --> APP : status
end
@enduml
