@startuml 01-visao-geral
title OrbitaPay — Visão geral dos componentes

skinparam componentStyle rectangle
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
left to right direction

actor "Cliente" as cliente
actor "Gerente / Admin" as gerente

node "App React Native (Expo)" as app

component "Gateway\n:9000" as gw <<Spring Boot>>

package "Microserviços (Spring Boot 4 / Java 21)" {
  component "Auth\n:9001" as aut
  component "Clientes\n(cliente + conta)\n:9002" as cli
  component "Ativos\n(catálogo + estoque)\n:9003" as atv
  component "Negociação\n(ordens + carteira)\n:9004" as neg
  component "Pagamentos\n:9005" as pag
}

database "orbita_auth" as dbaut
database "orbita_clientes" as dbcli
database "orbita_ativos" as dbatv
database "orbita_negociacao" as dbneg
database "orbita_pagamentos" as dbpag

queue "RabbitMQ\nexchange orbita.eventos" as mq

cliente --> app
gerente --> app
app --> gw : HTTP /api/**\ncookie de sessão + X-Assinatura

gw --> aut : /api/autenticacao\n+ GET /interno/acessos
gw --> cli : /api/clientes · /api/contas
gw --> atv : /api/ativos · /api/bolsas
gw --> neg : /api/ordens · /api/carteiras
gw --> pag : /api/pagamentos

aut --> cli : HTTP · bloqueio por PIN
cli --> aut : HTTP · troca de e-mail
neg --> atv : HTTP · cotação e estoque
neg --> cli : HTTP · situação, débito e crédito

pag ..> mq : pagamento.confirmado
neg ..> mq : ordem.solicitada
mq ..> neg : executa a ordem
mq ..> pag : remove pagamentos
cli ..> mq : cliente.removido
mq ..> cli : crédito do depósito
mq ..> aut : remove credencial
mq ..> neg : remove carteira

aut --> dbaut
cli --> dbcli
atv --> dbatv
neg --> dbneg
pag --> dbpag
@enduml
